# Public, non-secret values only. Never put secrets in NEXT_PUBLIC_* variables.
# Canonical origin used for metadata, sitemap, robots and llms.txt. Defaults to
# https://www.picstea.com. In Vercel Production it must be exactly the host Vercel serves
# (https://www.picstea.com); it is baked in at build time, so redeploy after changing it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AdSense (website pages only, loaded after consent). Leave empty to disable all Google ads.
# Publisher ID, e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=
# A responsive display ad unit ID used by the website ad spaces, e.g. 1234567890
NEXT_PUBLIC_ADSENSE_SLOT=
# Who asks for advertising consent: "own" (default) = Picstea's banner, non-personalised ads only;
# "google" = Google's certified "Privacy & messaging" CMP (IAB TCF), which allows personalised ads
# in the EEA/UK/CH. WARNING: set "google" only AFTER the European regulations message is
# published in AdSense → Privacy & messaging — otherwise ads load with no consent prompt.
NEXT_PUBLIC_ADSENSE_CMP=own
